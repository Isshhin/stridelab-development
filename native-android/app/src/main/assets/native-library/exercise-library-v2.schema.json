            "minItems": 0,
            "uniqueItems": true
          },
          "progressions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "prerequisiteNotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "technique": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "easier": {
            "type": "string",
            "minLength": 1
          },
          "harder": {
            "type": "string",
            "minLength": 1
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "provenance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
