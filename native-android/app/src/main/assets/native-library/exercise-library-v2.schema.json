            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "exercise",
              "guide"
            ]
          },
          "categories": {
            "type": "array",
            "items": {
              "enum": [
                "strength_gym",
                "calisthenics",
                "bodyweight",
                "conditioning",
                "mobility",
                "running"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "movementPatterns": {
            "type": "array",
            "items": {
              "enum": [
                "ankle_mobility",
                "anti_extension",
                "anti_lateral_flexion",
                "calf_raise",
                "carry",
                "chest_mobility",
                "core",
                "cyclic_cardio",
                "dip",
                "elbow_flexion",
                "gait",
                "hinge",
                "hip_extension",
                "horizontal_press",
                "horizontal_pull",
                "inversion",
                "jumping",
                "knee_flexion",
                "lateral_flexion",
                "neck_rotation",
                "quadruped_control",
                "squat",
                "stepping",
                "support",
                "thoracic_rotation",
                "unilateral",
                "vertical_pull"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "primaryMuscles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "secondaryMuscles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "equipmentOptions": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "enum": [
                  "anchor",
                  "assistance_setup",
                  "band",
                  "barbell",
                  "bench",
                  "chair",
                  "chest_press_machine",
                  "dumbbells",
                  "lat_pulldown_machine",
                  "leg_curl_machine",
                  "leg_press_machine",
                  "low_bar",
                  "one_weight",
                  "parallel_bars",
                  "parallettes",
                  "pullup_bar",
                  "rack",
                  "raised_surface",
                  "rings",
                  "safe_hill_route",
                  "safe_route",
                  "safeties",
                  "stationary_bike",
                  "two_weights",
                  "wall"
