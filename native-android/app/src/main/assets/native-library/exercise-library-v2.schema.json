  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stridelab.invalid/schemas/exercise-library-v2.schema.json",
  "title": "StrideLab Exercise Library 2.0 companion"
}
