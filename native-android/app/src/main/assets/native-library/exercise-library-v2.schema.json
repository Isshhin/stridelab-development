                "scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "sourceId",
                "scope"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "mediaId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "categories",
          "movementPatterns",
          "primaryMuscles",
          "secondaryMuscles",
          "equipmentOptions",
          "setupNotes",
          "difficulty",
          "prerequisites",
          "regressions",
          "progressions",
          "alternatives",
          "prerequisiteNotes",
          "technique",
          "easier",
          "harder",
          "caveats",
          "provenance",
          "mediaId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "libraryVersion",
    "baselineCommit",
    "baselineCatalogSha256",
    "editorialPolicy",
    "sources",
    "records"
