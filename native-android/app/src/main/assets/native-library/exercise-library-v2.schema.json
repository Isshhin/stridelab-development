{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "libraryVersion": {
      "const": "2.0.0"
    },
    "baselineCommit": {
      "const": "25be8f3828374d1e539c7e825afa20fbcb652b56"
    },
    "baselineCatalogSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "editorialPolicy": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "textRights": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "accessed",
          "scope",
          "textRights"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
